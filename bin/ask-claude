#!/bin/bash
# ask-claude - Invoke Claude from Codex or terminal
# Usage: ask-claude "your prompt here"
#        echo "prompt" | ask-claude
#        ask-claude --context file.md "analyze this"

set -e

# Headless child agents must not publish identity into their parent Orca pane.
unset ORCA_PANE_KEY ORCA_TAB_ID ORCA_AGENT_LAUNCH_TOKEN

# Show help
if [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
  echo "Usage: ask-claude [OPTIONS] \"prompt\""
  echo ""
  echo "Options:"
  echo "  --context, -c FILE   Include file contents as context"
  echo "  --model, -m MODEL    Specify model (sonnet, opus, haiku)"
  echo "  --plan               Use plan mode (read-only analysis)"
  echo "  --accept-edits       Auto-accept file edits"
  echo "  --stream             Stream text output (useful for long responses)"
  echo "  --keep-env           Do NOT strip ANTHROPIC_* proxy vars (see below)"
  echo "  --help, -h           Show this help"
  echo ""
  echo "Proxy safety:"
  echo "  By default this strips ANTHROPIC_BASE_URL/AUTH_TOKEN/MODEL and friends so"
  echo "  the call reaches Anthropic directly using your own Claude login. Without"
  echo "  that, running under a local proxy (e.g. CLIProxyAPI serving a non-Claude"
  echo "  model) silently routes this request back to the caller — you would be"
  echo "  reviewing your own work while believing you got a second opinion."
  echo "  Pass --keep-env only if you deliberately want the proxied model."
  echo ""
  echo "Examples:"
  echo "  ask-claude \"Explain this architecture\""
  echo "  ask-claude --plan \"What's the best approach for caching?\""
  echo "  ask-claude --context plan.md \"Implement step 3\""
  echo "  ask-claude --plan --stream \"Write a longer plan\""
  exit 0
fi

# Parse arguments
CONTEXT_FILE=""
PROMPT=""
MODEL=""
PERMISSION_MODE="default"
STREAM_MODE="false"
KEEP_ENV="false"

while [[ $# -gt 0 ]]; do
  case $1 in
    --keep-env)
      KEEP_ENV="true"
      shift
      ;;
    --context|-c)
      CONTEXT_FILE="$2"
      shift 2
      ;;
    --model|-m)
      MODEL="$2"
      shift 2
      ;;
    --plan)
      PERMISSION_MODE="plan"
      shift
      ;;
    --accept-edits)
      PERMISSION_MODE="acceptEdits"
      shift
      ;;
    --stream)
      STREAM_MODE="true"
      shift
      ;;
    *)
      PROMPT="$1"
      shift
      ;;
  esac
done

# Read from stdin if no prompt provided and stdin is not a terminal
if [[ -z "$PROMPT" ]] && [[ ! -t 0 ]]; then
  PROMPT=$(cat)
fi

if [[ -z "$PROMPT" ]]; then
  echo "Usage: ask-claude [--context file.md] [--model model] [--plan|--accept-edits] \"prompt\"" >&2
  echo "Run 'ask-claude --help' for more information." >&2
  exit 1
fi

# Build context prefix if provided
if [[ -n "$CONTEXT_FILE" ]] && [[ -f "$CONTEXT_FILE" ]]; then
  CONTEXT_CONTENT=$(cat "$CONTEXT_FILE")
  PROMPT="Context from $CONTEXT_FILE:

$CONTEXT_CONTENT

---

$PROMPT"
fi

# Resolve Orca's selected Claude host account for parents without an explicit
# CLAUDE_CONFIG_DIR. Use its existing profile/auth directory; never copy credentials.
if [[ "$KEEP_ENV" != "true" && -z "${CLAUDE_CONFIG_DIR:-}" ]]; then
  ORCA_CLAUDE_CONFIG_DIR=$(python3 - <<'PY_ACCOUNT'
import json
import os
from pathlib import Path
import stat
import sys

root = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "orca"
profiles_dir = root / "claude-profiles"
pointer = profiles_dir / "selected-host"
try:
    if os.path.lexists(pointer):
        if profiles_dir.is_symlink():
            raise ValueError("Orca claude-profiles directory must not be a symlink")
        if not stat.S_ISREG(os.lstat(pointer).st_mode):
            raise ValueError("selected-host pointer must be a regular file")
        raw = pointer.read_text().strip()
        if not raw:
            sys.exit(0)
        if "\n" in raw or "\r" in raw or "\0" in raw:
            raise ValueError("invalid selected-host pointer")
        raw_path = Path(raw).expanduser()
        if not raw_path.is_absolute() or ".." in raw_path.parts:
            raise ValueError("invalid selected-host pointer")
        profiles_root = profiles_dir.resolve()
        raw_rel = None
        for base in (profiles_dir, profiles_root):
            try:
                raw_rel = raw_path.relative_to(base)
                break
            except ValueError:
                continue
        if raw_rel is None:
            raise ValueError("selected-host pointer escapes Orca claude-profiles")
        if len(raw_rel.parts) != 2 or raw_rel.parts[1] != "home":
            raise ValueError("selected-host pointer is not a claude-profiles/<id>/home path")
        account_id = raw_rel.parts[0]
        if not account_id or Path(account_id).name != account_id or account_id in (".", "..") or account_id.startswith("."):
            raise ValueError("invalid selected account")
        account_dir = profiles_dir / account_id
        home_dir = account_dir / "home"
        if account_dir.is_symlink() or home_dir.is_symlink():
            raise ValueError("selected-host profile directory must not be a symlink")
        home = home_dir.resolve()
        if home != profiles_root / account_id / "home" or raw_path.resolve() != home:
            raise ValueError("selected-host pointer escapes Orca claude-profiles")
        if not home.is_dir():
            raise ValueError("selected Orca account has no credentials; reconnect that account in Orca")
        cred = home / ".credentials.json"
        if not os.path.lexists(cred):
            raise ValueError("selected Orca account has no credentials; reconnect that account in Orca")
        if not stat.S_ISREG(os.lstat(cred).st_mode):
            raise ValueError("selected Orca account credentials must be a regular file")
        print(home)
        sys.exit(0)

    index = root / "orca-profile-index.json"
    if not index.exists():
        sys.exit(0)
    profile = json.loads(index.read_text())["activeProfileId"]
    if not isinstance(profile, str) or not profile or Path(profile).name != profile or profile in (".", ".."):
        raise ValueError("invalid active profile")
    settings = json.loads((root / "profiles" / profile / "orca-data.json").read_text())["settings"]
    runtime = settings.get("activeClaudeManagedAccountIdsByRuntime")
    account = runtime.get("host") if isinstance(runtime, dict) else settings.get("activeClaudeManagedAccountId")
    if account is not None:
        if (
            not isinstance(account, str)
            or not account
            or Path(account).name != account
            or account in (".", "..")
            or account.startswith(".")
        ):
            raise ValueError("invalid selected account")
        accounts = settings.get("claudeManagedAccounts", [])
        record = next((item for item in accounts if item.get("id") == account), None)
        if not record or record.get("managedAuthRuntime", "host") != "host":
            raise ValueError("selected account is not a registered host account")
        selected = root / "claude-accounts" / account / "auth"
        profile_account_dir = profiles_dir / account
        profile_home = profile_account_dir / "home"
        managed_raw = record.get("managedAuthPath")
        if not isinstance(managed_raw, str) or not managed_raw:
            raise ValueError("selected account auth path does not match its Orca directory")
        managed_resolved = Path(managed_raw).resolve()
        valid_targets = {selected.resolve()}
        if not (profiles_dir.is_symlink() or profile_account_dir.is_symlink() or profile_home.is_symlink()):
            valid_targets.add(profile_home.resolve())
        if managed_resolved not in valid_targets:
            raise ValueError("selected account auth path does not match its Orca directory")
        if os.path.lexists(profile_home):
            if profiles_dir.is_symlink() or profile_account_dir.is_symlink() or profile_home.is_symlink():
                raise ValueError("selected account profile directory must not be a symlink")
            if profile_home.resolve() != profiles_dir.resolve() / account / "home":
                raise ValueError("selected account profile home escapes Orca claude-profiles")
            profile_cred = profile_home / ".credentials.json"
            if os.path.lexists(profile_cred):
                if not stat.S_ISREG(os.lstat(profile_cred).st_mode):
                    raise ValueError("selected Orca account credentials must be a regular file")
                if profile_home.is_dir():
                    print(profile_home)
                    sys.exit(0)
        legacy_cred = selected / ".credentials.json"
        if managed_resolved == selected.resolve() and os.path.lexists(legacy_cred):
            if not stat.S_ISREG(os.lstat(legacy_cred).st_mode):
                raise ValueError("selected Orca account credentials must be a regular file")
            if selected.is_dir():
                print(selected)
                sys.exit(0)
        raise ValueError("selected Orca account has no credentials; reconnect that account in Orca")
except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
    print(f"ask-claude: cannot resolve Orca account: {error}", file=sys.stderr)
    sys.exit(2)
PY_ACCOUNT
  ) || exit $?
  if [[ -n "$ORCA_CLAUDE_CONFIG_DIR" ]]; then
    export CLAUDE_CONFIG_DIR="$ORCA_CLAUDE_CONFIG_DIR"
    # Managed credentials must not be overridden by inherited OAuth headers/tokens.
    unset CLAUDE_CODE_OAUTH_TOKEN AWS_BEARER_TOKEN_BEDROCK ANTHROPIC_CUSTOM_HEADERS
    echo "ask-claude: using Orca selected Claude home: $CLAUDE_CONFIG_DIR" >&2
  fi
fi

# Strip proxy env by default.
#
# The whole point of ask-claude is to reach a *different* model family than the
# caller. If the caller is itself Claude Code pointed at a local proxy (e.g.
# CLIProxyAPI serving GPT-5.x), those ANTHROPIC_* vars are inherited by this
# child process and the request loops straight back to the caller — a second
# opinion that is actually the same model answering itself, with nothing in the
# output to reveal it. Strip them so the call uses the real Claude login.
ENV_PREFIX=""
if [[ "$KEEP_ENV" != "true" ]]; then
  if [[ -n "$ANTHROPIC_BASE_URL" ]]; then
    echo "ask-claude: stripping ANTHROPIC_* (proxy detected at $ANTHROPIC_BASE_URL) — calling Claude directly" >&2
  fi
  ENV_PREFIX="env -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_API_KEY \
-u ANTHROPIC_MODEL -u ANTHROPIC_DEFAULT_OPUS_MODEL -u ANTHROPIC_DEFAULT_SONNET_MODEL \
-u ANTHROPIC_DEFAULT_HAIKU_MODEL -u ANTHROPIC_SMALL_FAST_MODEL -u CLAUDE_CODE_SUBAGENT_MODEL"
elif [[ -n "$ANTHROPIC_BASE_URL" ]]; then
  echo "ask-claude: --keep-env set — request goes through $ANTHROPIC_BASE_URL, NOT to Claude" >&2
fi

# Build command
CMD="$ENV_PREFIX claude --print"

if [[ -n "$MODEL" ]]; then
  CMD="$CMD --model $MODEL"
fi

CMD="$CMD --permission-mode $PERMISSION_MODE"

# Execute and capture output
echo "--- Claude Response ---" >&2

if [[ "$STREAM_MODE" == "true" ]]; then
  # Stream JSON events from Claude and extract only the text deltas.
  #
  # NOTE: We do NOT merge stderr into stdout here; stderr may contain non-JSON output
  # which would break the JSON parser.
  $CMD --verbose --output-format=stream-json --include-partial-messages "$PROMPT" \
    2> >(cat >&2) \
    | python3 -u -c $'import json,sys\nprinted_any=False\nlast_char=\"\"\n\ndef emit(s):\n  global printed_any,last_char\n  if not s:\n    return\n  printed_any=True\n  last_char=s[-1]\n  sys.stdout.write(s)\n  sys.stdout.flush()\n\nfor line in sys.stdin:\n  line=line.strip()\n  if not line:\n    continue\n  try:\n    obj=json.loads(line)\n  except Exception:\n    continue\n  t=obj.get(\"type\")\n  if t==\"stream_event\":\n    ev=obj.get(\"event\") or {}\n    ev_t=ev.get(\"type\")\n    if ev_t==\"content_block_start\":\n      cb=ev.get(\"content_block\") or {}\n      if cb.get(\"type\")==\"text\":\n        emit(cb.get(\"text\") or \"\")\n    elif ev_t==\"content_block_delta\":\n      delta=ev.get(\"delta\") or {}\n      if delta.get(\"type\")==\"text_delta\":\n        emit(delta.get(\"text\") or \"\")\n  elif t==\"result\" and not printed_any:\n    emit(obj.get(\"result\") or \"\")\n\nif printed_any and last_char!=\"\\n\":\n  sys.stdout.write(\"\\n\")\n'
else
  $CMD "$PROMPT" 2>&1
fi

echo "--- End Claude Response ---" >&2
