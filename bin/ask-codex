#!/bin/bash
# ask-codex - Invoke Codex from Claude or terminal
# Usage: ask-codex "your prompt here"
#        echo "prompt" | ask-codex
#        ask-codex --context file.md "analyze this"

set -e

# Headless child agents must not publish identity into their parent Orca pane.
unset ORCA_PANE_KEY ORCA_TAB_ID ORCA_AGENT_LAUNCH_TOKEN

# Show help
if [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
  echo "Usage: ask-codex [OPTIONS] \"prompt\""
  echo ""
  echo "Options:"
  echo "  --context, -c FILE   Include file contents as context"
  echo "  --model, -m MODEL    Specify model (default: codex default)"
  echo "  --effort, -e LEVEL   Reasoning effort for this run: low|medium|high|xhigh|max|ultra (ultra = Codex-only; the lane fans out to its own subagents)"
  echo "                       (maps to codex exec -c model_reasoning_effort=LEVEL; the config default is not the lane's)"
  echo "  --readonly, -r       Use read-only sandbox (no file writes)"
  echo "  --clean              Extract only final response (strip session logs)"
  echo "  --output, -o FILE    Save the final response to FILE (written by the CLI, works with --readonly)"
  echo "  --debug-log FILE     Save raw session transcript to this file"
  echo "  --worktree BRANCH    Run the lane in its own git worktree on BRANCH, at"
  echo "                       \${ASK_CODEX_WORKTREE_ROOT:-~/runs/codex-worktrees}/<repo>/<branch with / as ->-<hash>,"
  echo "                       where <hash> is the first 8 hex chars of sha1(BRANCH) (lane/x -> lane-x-<hash>)."
  echo "                       Reuses that worktree when it already exists on BRANCH (a resumed lane);"
  echo "                       creates BRANCH from --base when it does not exist. Never removes it."
  echo "  --base REF           Start point for a new --worktree branch (default: HEAD)"
  echo "  --resume SESSION_ID  Continue an interrupted session (codex exec resume). The prompt is"
  echo "                       optional; the default asks the lane to carry on with the same work order."
  echo "                       --context and the output instruction are not re-sent. Add --worktree to"
  echo "                       resume inside that lane's worktree; without it the resume starts in the"
  echo "                       session's saved directory (read from its rollout file)."
  echo "                       Every run prints its session id on stderr when codex reports one, with"
  echo "                       the full resume command (worktree, --readonly, model, effort, --clean)."
  echo "  --help, -h           Show this help"
  echo ""
  echo "Examples:"
  echo "  ask-codex \"Review this code for bugs\""
  echo "  ask-codex --readonly \"What files handle auth?\""
  echo "  ask-codex --context spec.md \"Implement this feature\""
  echo "  ask-codex --clean --output plan.md \"Create an implementation plan\""
  echo "  ask-codex --effort xhigh --readonly \"Review the uncommitted diff adversarially\""
  echo "  ask-codex --worktree lane/issue-19 --context order.md \"Implement the order\""
  echo "  ask-codex --resume 01a0fc4d-31bf-7df0-9335-8530299f95f3 --worktree lane/issue-19"
  exit 0
fi

# Parse arguments
CONTEXT_FILE=""
PROMPT=""
MODEL=""
EFFORT=""
SANDBOX="workspace-write"
CLEAN=false
OUTPUT_FILE=""
DEBUG_LOG=""
WORKTREE_BRANCH=""
WORKTREE_BASE="HEAD"
RESUME_ID=""
CONTINUE_PROMPT="You were interrupted. Continue the same work order from where you stopped; your final message is still the deliverable."

while [[ $# -gt 0 ]]; do
  case $1 in
    --context|-c)
      CONTEXT_FILE="$2"
      shift 2
      ;;
    --model|-m)
      MODEL="$2"
      shift 2
      ;;
    --effort|-e)
      EFFORT="$2"
      case "$EFFORT" in low|medium|high|xhigh|max|ultra) ;; *)
        echo "ask-codex: --effort must be one of low|medium|high|xhigh|max|ultra (got '$EFFORT')" >&2; exit 2;; esac
      shift 2
      ;;
    --readonly|-r)
      SANDBOX="read-only"
      shift
      ;;
    --full-auto)
      # kept for older call sites; workspace-write is already the default
      SANDBOX="workspace-write"
      shift
      ;;
    --clean)
      CLEAN=true
      shift
      ;;
    --output|-o)
      OUTPUT_FILE="$2"
      shift 2
      ;;
    --debug-log)
      DEBUG_LOG="$2"
      shift 2
      ;;
    --worktree)
      WORKTREE_BRANCH="$2"
      shift 2
      ;;
    --base)
      WORKTREE_BASE="$2"
      shift 2
      ;;
    --resume)
      RESUME_ID="$2"
      shift 2
      ;;
    *)
      PROMPT="$1"
      shift
      ;;
  esac
done

# Read from stdin if no prompt provided and stdin is not a terminal
if [[ -z "$PROMPT" ]] && [[ ! -t 0 ]]; then
  PROMPT=$(cat)
fi

# A resume needs no prompt of its own: the session already holds the work
# order, its context and the output instruction.
RESUME=false
if [[ -n "$RESUME_ID" ]]; then
  RESUME=true
  [[ -n "$PROMPT" ]] || PROMPT="$CONTINUE_PROMPT"
fi

if [[ -z "$PROMPT" ]]; then
  echo "Usage: ask-codex [--context file.md] [--model model] [--effort level] [--readonly] \"prompt\"" >&2
  echo "Run 'ask-codex --help' for more information." >&2
  exit 1
fi

# If --output is set, the file is written by the codex CLI itself (-o /
# --output-last-message), OUTSIDE the sandbox — so it works under --readonly too.
# Do NOT ask the model to write the file: in a read-only sandbox that patch is
# rejected and the deliverable is silently lost, which is exactly the combination
# the review and verification lanes use.
if [[ -n "$OUTPUT_FILE" ]]; then
  # Make path absolute if relative
  if [[ "$OUTPUT_FILE" != /* ]]; then
    OUTPUT_FILE="$(pwd)/$OUTPUT_FILE"
  fi
fi
if [[ -n "$OUTPUT_FILE" ]] && [[ "$RESUME" == false ]]; then
  PROMPT="$PROMPT

IMPORTANT OUTPUT INSTRUCTION: Your FINAL message IS the deliverable and will be saved verbatim to a file. Return the COMPLETE, polished document as your final message — every section, table and citation. Do not try to write files yourself; do not include investigation notes, tool logs, or reasoning steps in it."
fi

# Build context prefix if provided. A missing context file is an error, not a
# silent skip: the work order IS the lane's scope, and launching without it sends
# a generic prompt with no constraints or acceptance check.
if [[ -n "$CONTEXT_FILE" ]] && [[ ! -f "$CONTEXT_FILE" ]]; then
  echo "ask-codex: --context file not found: $CONTEXT_FILE" >&2
  exit 2
fi
if [[ -n "$CONTEXT_FILE" ]] && [[ "$RESUME" == false ]]; then
  CONTEXT_CONTENT=$(cat "$CONTEXT_FILE")
  PROMPT="Context from $CONTEXT_FILE:

$CONTEXT_CONTENT

---

$PROMPT"
fi

# --worktree: give a write lane its own checkout so two lanes in one repo do not
# share a working tree. Codex's native `exec --worktree` is NOT used: it makes a
# detached-HEAD checkout under $CODEX_HOME/worktrees/, with no branch name to
# integrate and in a home that differs per account, so the orchestrator could
# not find or merge the lane's work. The worktree is never removed here; the
# orchestrator removes it after it has integrated the branch.
WT_PATH=""
WT_REPO_TOP=""
if [[ -n "$WORKTREE_BRANCH" ]]; then
  if ! WT_REPO_TOP=$(git rev-parse --show-toplevel 2>/dev/null); then
    echo "ask-codex: --worktree needs the current directory to be inside a git repository ($(pwd) is not)." >&2
    exit 2
  fi
  if ! git check-ref-format --branch "$WORKTREE_BRANCH" >/dev/null 2>&1; then
    echo "ask-codex: --worktree '$WORKTREE_BRANCH' is not a valid branch name." >&2
    exit 2
  fi
  # Name the folder after the repository, not after whichever linked worktree
  # the caller happens to stand in: the common .git dir's parent is the repo.
  WT_COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  if [[ "$(basename "$WT_COMMON_DIR")" == ".git" ]]; then
    WT_REPO_NAME=$(basename "$(dirname "$WT_COMMON_DIR")")
  else
    WT_REPO_NAME=$(basename "$WT_REPO_TOP")
  fi
  # Readable slug plus the first 8 hex chars of sha1(branch): lane/x and lane-x
  # share a slug and must not share a folder. (python3, not sha1sum: macOS has none.)
  WT_HASH=$(python3 -c 'import hashlib,sys; print(hashlib.sha1(sys.argv[1].encode()).hexdigest()[:8])' "$WORKTREE_BRANCH")
  WT_PATH="${ASK_CODEX_WORKTREE_ROOT:-$HOME/runs/codex-worktrees}/$WT_REPO_NAME/${WORKTREE_BRANCH//\//-}-$WT_HASH"
  # Which branch (if any) is checked out at WT_PATH as a worktree of THIS repo?
  WT_REGISTERED_BRANCH=""
  WT_REGISTERED=false
  WT_WANT=$(realpath -m "$WT_PATH")
  wt_current=""
  while IFS= read -r wt_line; do
    case "$wt_line" in
      "worktree "*) wt_current=$(realpath -m "${wt_line#worktree }") ;;
      "branch "*)
        if [[ "$wt_current" == "$WT_WANT" ]]; then WT_REGISTERED_BRANCH="${wt_line#branch refs/heads/}"; fi ;;
    esac
    if [[ "$wt_current" == "$WT_WANT" ]]; then WT_REGISTERED=true; fi
  done < <(git worktree list --porcelain 2>/dev/null)
  if [[ -e "$WT_PATH" ]]; then
    if [[ "$WT_REGISTERED" == true ]] && [[ "$WT_REGISTERED_BRANCH" == "$WORKTREE_BRANCH" ]]; then
      echo "ask-codex: reusing worktree $WT_PATH on branch $WORKTREE_BRANCH" >&2
    else
      echo "ask-codex: $WT_PATH exists but is not a worktree of $WT_REPO_TOP on branch $WORKTREE_BRANCH; refusing to use it." >&2
      exit 2
    fi
  else
    mkdir -p "$(dirname "$WT_PATH")"
    if git show-ref --verify --quiet "refs/heads/$WORKTREE_BRANCH"; then
      git worktree add "$WT_PATH" "$WORKTREE_BRANCH" >&2 || {
        echo "ask-codex: could not add a worktree for existing branch $WORKTREE_BRANCH (is it checked out elsewhere?)." >&2; exit 2; }
    else
      git worktree add -b "$WORKTREE_BRANCH" "$WT_PATH" "$WORKTREE_BASE" >&2 || {
        echo "ask-codex: could not create branch $WORKTREE_BRANCH from $WORKTREE_BASE in a new worktree." >&2; exit 2; }
    fi
    echo "ask-codex: created worktree $WT_PATH on branch $WORKTREE_BRANCH" >&2
  fi
  if [[ "$RESUME" == false ]]; then
    PROMPT="WORKTREE: You are working in the git worktree $WT_PATH on branch $WORKTREE_BRANCH. Make every change inside that directory and commit your changes on branch $WORKTREE_BRANCH before you finish. Do not switch branches, and do not touch the main checkout at $WT_REPO_TOP.

$PROMPT"
  fi
fi

# Print where a worktree lane left its work. Called once the run is over,
# whatever its outcome: a failed lane's commits are still worth integrating.
report_worktree() {
  [[ -n "$WT_PATH" ]] || return 0
  {
    echo "ask-codex: worktree $WT_PATH"
    echo "ask-codex: branch   $WORKTREE_BRANCH"
    echo "ask-codex: commits ($WORKTREE_BASE..$WORKTREE_BRANCH, first 10):"
    git -C "$WT_REPO_TOP" log --oneline "$WORKTREE_BASE..$WORKTREE_BRANCH" 2>&1 | head -n 10 | sed 's/^/  /'
    echo "ask-codex: uncommitted (first 10):"
    git -C "$WT_PATH" status --short 2>&1 | head -n 10 | sed 's/^/  /'
    echo "ask-codex: remove it after integrating: git worktree remove $WT_PATH"
  } >&2 || true
}

# A Claude parent usually has no CODEX_HOME. Resolve Orca's selected host
# account at launch time; never copy tokens or overwrite an explicit lane home.
if [[ -z "${CODEX_HOME:-}" ]]; then
  ORCA_CODEX_HOME=$(python3 - <<'PY_ACCOUNT'
import json
import os
from pathlib import Path
import sys

root = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "orca"
index = root / "orca-profile-index.json"
if not index.exists():
    sys.exit(0)
try:
    profile = json.loads(index.read_text())["activeProfileId"]
    if not isinstance(profile, str) or not profile or Path(profile).name != profile or profile in (".", ".."):
        raise ValueError("invalid active profile")
    settings = json.loads((root / "profiles" / profile / "orca-data.json").read_text())["settings"]
    runtime = settings.get("activeCodexManagedAccountIdsByRuntime")
    account = runtime.get("host") if isinstance(runtime, dict) else settings.get("activeCodexManagedAccountId")
    if account is not None:
        if not isinstance(account, str) or not account or Path(account).name != account or account in (".", ".."):
            raise ValueError("invalid selected account")
        selected = root / "codex-accounts" / account / "home"
        if not (selected / "auth.json").is_file():
            raise ValueError("selected Orca account has no auth.json; reconnect that account in Orca")
        print(selected)
except (OSError, ValueError, KeyError, TypeError) as error:
    print(f"ask-codex: cannot resolve Orca account: {error}", file=sys.stderr)
    sys.exit(2)
PY_ACCOUNT
  ) || exit $?
  if [[ -n "$ORCA_CODEX_HOME" ]]; then
    export CODEX_HOME="$ORCA_CODEX_HOME"
    echo "ask-codex: using Orca selected Codex home: $CODEX_HOME" >&2
  fi
fi

# Build command as an ARGUMENT ARRAY, never a string: a string expanded unquoted
# word-splits paths with spaces and lets a crafted --output/--model value inject
# extra arguments (e.g. a second -c override) after the validated ones.
# `codex exec resume` has no --sandbox and no -C: the sandbox goes in as a config
# override and the run starts from the lane's directory instead (see RUN_DIR).
if [[ "$RESUME" == true ]]; then
  CMD=(codex exec resume)
else
  CMD=(codex exec)
fi

if [[ -n "$MODEL" ]]; then
  CMD+=(--model "$MODEL")
fi

if [[ -n "$EFFORT" ]]; then
  CMD+=(-c "model_reasoning_effort=$EFFORT")
fi

# codex-cli 0.153+ removed --full-auto (it was "workspace-write + approve on failure"), and
# `codex exec` has no --ask-for-approval flag of its own — approval policy is a config key.
# A headless lane cannot answer approval prompts, so it is overridden to "never" here and
# the sandbox flag carries the write policy (--readonly still maps to the read-only sandbox).
if [[ "$RESUME" == true ]]; then
  CMD+=(-c approval_policy=never --enable multi_agent)
else
  CMD+=(--sandbox "$SANDBOX" -c approval_policy=never --enable multi_agent)
fi

# For --clean mode, use Codex's native -o flag to extract just the final response
# This replaces the old awk parser which broke when Codex changed its output format
CLEAN_TMPFILE=""
if [[ -n "$OUTPUT_FILE" ]]; then
  # Native last-message capture — written by the CLI, not the sandboxed model.
  CMD+=(-o "$OUTPUT_FILE")
elif [[ "$CLEAN" == true ]]; then
  # BSD mktemp only substitutes TRAILING Xs — a .txt suffix after them leaves
  # the template literal and invites collisions.
  CLEAN_TMPFILE=$(mktemp "${TMPDIR:-/tmp}/codex-clean-XXXXXX")
  CMD+=(-o "$CLEAN_TMPFILE")
fi

if [[ "$RESUME" == true ]]; then
  CMD+=(-c "sandbox_mode=\"$SANDBOX\"" "$RESUME_ID")
elif [[ -n "$WT_PATH" ]]; then
  CMD+=(-C "$WT_PATH")
fi
# Every run starts from the caller's directory, except a worktree lane, which
# starts inside its worktree so that a resume (no -C) works there too.
RUN_DIR="${WT_PATH:-$PWD}"
# Codex 0.160's `exec resume` works in the CURRENT directory, not the one the
# session was saved with. A resume without --worktree therefore starts from the
# session's saved cwd: the first line of its rollout is a session_meta record
# whose payload carries "cwd".
if [[ "$RESUME" == true ]] && [[ -z "$WT_PATH" ]]; then
  SAVED_CWD=""
  if [[ "$RESUME_ID" =~ ^[0-9A-Za-z-]+$ ]]; then
    ROLLOUT=$(find "${CODEX_HOME:-$HOME/.codex}/sessions" -type f -name "rollout-*-$RESUME_ID.jsonl" 2>/dev/null | head -n 1 || true)
    if [[ -n "$ROLLOUT" ]]; then
      SAVED_CWD=$(head -n 1 "$ROLLOUT" | python3 -c 'import json,sys
d=json.loads(sys.stdin.read())
print(d["payload"]["cwd"] if d.get("type")=="session_meta" else "")' 2>/dev/null || true)
    fi
  fi
  if [[ -n "$SAVED_CWD" ]] && [[ -d "$SAVED_CWD" ]]; then
    RUN_DIR="$SAVED_CWD"
    echo "ask-codex: resuming session $RESUME_ID in its saved directory $RUN_DIR" >&2
  else
    echo "ask-codex: WARNING could not read the saved directory of session $RESUME_ID; resuming in $RUN_DIR, and the current directory decides where the lane works." >&2
  fi
fi

# The hint for continuing this run repeats what `exec resume` would otherwise
# take from the caller's directory and defaults: worktree, sandbox, model, effort.
resume_hint() {
  local hint="ask-codex --resume $(printf '%q' "$1")"
  [[ -z "$WORKTREE_BRANCH" ]] || hint+=" --worktree $(printf '%q' "$WORKTREE_BRANCH")"
  [[ "$SANDBOX" != "read-only" ]] || hint+=" --readonly"
  [[ -z "$MODEL" ]] || hint+=" -m $(printf '%q' "$MODEL")"
  [[ -z "$EFFORT" ]] || hint+=" --effort $EFFORT"
  [[ -z "$OUTPUT_FILE" ]] || hint+=" --output $(printf '%q' "$OUTPUT_FILE")"
  [[ "$CLEAN" != true ]] || hint+=" --clean"
  printf '%s' "$hint"
}

# Execute — keep stderr separate from stdout, but do NOT discard it.
#
# Discarding stderr and forcing success is how a broken lane becomes an invisible
# one: codex refuses to run outside a git repo ("Not inside a trusted directory"),
# and with `2>/dev/null || true` that surfaced to the caller as exit 0 with empty
# output — indistinguishable from a successful run that had nothing to say.
echo "--- Codex Response ---" >&2
CODEX_STDERR=$(mktemp "${TMPDIR:-/tmp}/codex-stderr-XXXXXX")
# `set -e` is on: assign in a form that survives a non-zero exit so the handler
# below actually runs instead of the script dying silently.
CODEX_STATUS=0
RAW_OUTPUT=$(cd "$RUN_DIR" && "${CMD[@]}" "$PROMPT" 2>"$CODEX_STDERR") || CODEX_STATUS=$?
# codex 0.160 prints "session id: <uuid>" in its stderr header.
SESSION_ID=$(grep -m1 -oE 'session id: [0-9A-Za-z-]+' "$CODEX_STDERR" 2>/dev/null | sed 's/^session id: //' || true)
if [[ -n "$SESSION_ID" ]]; then
  echo "ask-codex: session id $SESSION_ID (continue it with: $(resume_hint "$SESSION_ID"))" >&2
fi
echo "--- End Codex Response ---" >&2
report_worktree

# "No usable output" must look at the -o file too: a run that streams progress to
# stderr and hands its answer to the CLI's last-message file has succeeded.
LAST_MSG_FILE="${OUTPUT_FILE:-$CLEAN_TMPFILE}"
if [[ $CODEX_STATUS -ne 0 ]] || { [[ -z "$RAW_OUTPUT" ]] && [[ -s "$CODEX_STDERR" ]] && [[ ! -s "$LAST_MSG_FILE" ]]; }; then
  echo "ask-codex: codex exited ${CODEX_STATUS} with no usable output." >&2
  sed 's/^/  codex: /' "$CODEX_STDERR" >&2
  rm -f "$CODEX_STDERR" "$CLEAN_TMPFILE"
  exit $(( CODEX_STATUS == 0 ? 1 : CODEX_STATUS ))
fi
rm -f "$CODEX_STDERR"

# Save debug log if requested
if [[ -n "$DEBUG_LOG" ]]; then
  echo "$RAW_OUTPUT" > "$DEBUG_LOG"
fi

# Output: --output and --clean both use the -o extracted last message, otherwise raw output
if [[ -n "$OUTPUT_FILE" ]]; then
  if [[ -s "$OUTPUT_FILE" ]]; then
    echo "ask-codex: report written to $OUTPUT_FILE ($(wc -c < "$OUTPUT_FILE" | tr -d ' ') bytes)" >&2
    [[ "$CLEAN" == true ]] && cat "$OUTPUT_FILE" || echo "$RAW_OUTPUT"
  else
    echo "ask-codex: WARNING -o produced an empty file; falling back to raw output" >&2
    echo "$RAW_OUTPUT" | tee "$OUTPUT_FILE"
  fi
elif [[ "$CLEAN" == true ]] && [[ -n "$CLEAN_TMPFILE" ]]; then
  if [[ -s "$CLEAN_TMPFILE" ]]; then
    cat "$CLEAN_TMPFILE"
  else
    # Fallback: if -o file is empty, output raw (Codex may not have written to it)
    echo "$RAW_OUTPUT"
  fi
  rm -f "$CLEAN_TMPFILE"
else
  echo "$RAW_OUTPUT"
fi
